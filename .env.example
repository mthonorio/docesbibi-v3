# Variáveis de Ambiente
#
# Copie para .env.local em desenvolvimento. Em produção (Railway), configure
# estas mesmas chaves em Project → Service → Variables — ver
# src/docs/RAILWAY_DEPLOY.md para o passo a passo completo.

# ---------- Banco de Dados (Postgres do próprio Railway) ----------
# Usado por src/lib/db.ts (pool `pg`) — toda a leitura/escrita do app passa
# por aqui, não há mais Supabase. Em produção o Railway injeta isso
# automaticamente se o banco Postgres estiver linkado ao serviço
# (${{Postgres.DATABASE_URL}} nas variáveis do serviço).
DATABASE_URL=postgresql://postgres:senha@localhost:5432/docesbibi
# true só se o Postgres exigir SSL (não é o caso do Postgres interno do
# Railway — deixe em branco/false nesse caso).
DATABASE_SSL=false

# ---------- Autenticação (NextAuth / Auth.js — login da gestora em /orders) ----------
# Gerar com: npx auth secret  (ou: openssl rand -base64 33)
AUTH_SECRET=

# ---------- Cloudflare R2 (imagens dos produtos) ----------
# URL pública do bucket (ex.: https://pub-xxxxxxxx.r2.dev ou domínio próprio),
# usada no browser para montar as URLs de imagem — ver src/lib/images.ts.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Credenciais de API (S3-compatible) — usadas em runtime por
# POST /api/products/upload-image (upload de imagem em /admin/produtos,
# ver src/lib/r2.ts) e pelo script de migração scripts/migrate-images-to-r2.mjs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------- Mercado Pago ----------
# Em dev/staging, usar credenciais de sandbox: ou "TEST-..." (credenciais de
# teste da sua conta principal), ou "APP_USR-..." de um usuário de teste
# (vendedor de teste) — os dois formatos existem, "APP_USR-" não é garantia
# de produção. Se tiver dúvida se uma credencial é de teste ou produção:
# `curl -H "Authorization: Bearer $TOKEN" https://api.mercadopago.com/users/me`
# — conta de teste tem "tags":["test_user",...] e e-mail @testuser.com na
# resposta. Ver src/docs/MERCADO_PAGO_GUIDE.md.
MERCADO_PAGO_ACCESS_TOKEN=TEST-...
MERCADO_PAGO_PUBLIC_KEY=TEST-...
# Secret do webhook (painel do Mercado Pago → Suas integrações → Webhooks).
# Obrigatório em produção — sem ele, /api/webhook rejeita todas as
# notificações; em dev, sem ele a validação é pulada (não recomendado pra
# testar o caminho real).
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------- E-mail (Resend — confirmação ao cliente + aviso à gestora) ----------
# https://resend.com/api-keys. Sem isso, src/lib/email.ts só loga um aviso
# e não envia nada (não quebra o fluxo de pedido/pagamento).
RESEND_API_KEY=
# Precisa ser um endereço de um domínio verificado no Resend para enviar a
# clientes reais — "onboarding@resend.dev" (o padrão se isso ficar vazio)
# só entrega para o e-mail da sua própria conta Resend, útil só em teste.
EMAIL_FROM=Doces Bibi <onboarding@resend.dev>
# Para onde vai o e-mail de "novo pedido" — a dona da loja, não o cliente.
STORE_OWNER_EMAIL=

# ---------- URLs públicas ----------
# URL final do site em produção (domínio próprio ou *.up.railway.app).
# Usada para back_urls do Mercado Pago e para a whitelist de CORS.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Base usada pelo frontend para chamar as rotas /api/* (deixe igual à
# NEXT_PUBLIC_BASE_URL — frontend e API rodam juntos no mesmo serviço).
NEXT_PUBLIC_API_URL=http://localhost:3000
