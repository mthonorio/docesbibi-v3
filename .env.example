# Variáveis de Ambiente
#
# Copie para .env.local em desenvolvimento. Em produção (Railway), configure
# estas mesmas chaves em Project → Service → Variables — ver
# src/docs/RAILWAY_DEPLOY.md para o passo a passo completo.

# ---------- Banco de Dados (Postgres do próprio Railway) ----------
# Usado por src/lib/db.ts (pool `pg`) — toda a leitura/escrita do app passa
# por aqui, não há mais Supabase. Em produção o Railway injeta isso
# automaticamente se o banco Postgres estiver linkado ao serviço
# (${{Postgres.DATABASE_URL}} nas variáveis do serviço).
DATABASE_URL=postgresql://postgres:senha@localhost:5432/docesbibi
# true só se o Postgres exigir SSL (não é o caso do Postgres interno do
# Railway — deixe em branco/false nesse caso).
DATABASE_SSL=false

# ---------- Autenticação (NextAuth / Auth.js — login da gestora em /orders) ----------
# Gerar com: npx auth secret  (ou: openssl rand -base64 33)
AUTH_SECRET=

# ---------- Cloudflare R2 (imagens dos produtos) ----------
# URL pública do bucket (ex.: https://pub-xxxxxxxx.r2.dev ou domínio próprio),
# usada no browser para montar as URLs de imagem — ver src/lib/images.ts.
NEXT_PUBLIC_R2_PUBLIC_URL=
# Credenciais de API (S3-compatible) — só usadas pelo script de migração
# scripts/migrate-images-to-r2.mjs, não em runtime do app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------- Mercado Pago ----------
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
# Secret do webhook (painel do Mercado Pago). Obrigatório em produção —
# sem ele, /api/webhook rejeita todas as notificações.
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------- URLs públicas ----------
# URL final do site em produção (domínio próprio ou *.up.railway.app).
# Usada para back_urls do Mercado Pago e para a whitelist de CORS.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Base usada pelo frontend para chamar as rotas /api/* (deixe igual à
# NEXT_PUBLIC_BASE_URL — frontend e API rodam juntos no mesmo serviço).
NEXT_PUBLIC_API_URL=http://localhost:3000
